# Superagent Starter Kit — connection settings
#
# Copy this file to `.env` and fill in the three required values. See
# instructions/setup.md for the walkthrough, including how the owner mints a token.
#
#   cp .env.example .env
#
# `.env` is gitignored. Values already present in the process environment always
# win over this file, so an agent can override any of these for a single call.


## ─── Required ────────────────────────────────────────────────────────────────

# The CLI gateway endpoint. Keep the ?api=cli — it is what selects the JSON API
# rather than the HTML site.
IC_URL=https://inspiration.city/?api=cli

# The workspace you are working in: space.<ic-username>, or place.<slug> for a
# place the account owns. Override per call with --base.
IC_BASE=space.your-ic-username

# The workspace token, minted by the owner in IC under Superagents -> token,
# where it is shown once. ONE token authenticates every agent on the workspace —
# there is nothing agent-specific about it, and rotating it re-keys all of them.
IC_TOKEN=paste-the-token-here


## ─── Your name ───────────────────────────────────────────────────────────────

# IC_AGENT is a LABEL, not a credential. It selects which room you work in and
# what is recorded against you on boards and assignment rows, but it
# authenticates nothing — the token does that. It must match a room the owner has
# enabled for you (local.superagent.<name>), or the gateway refuses the call.
#
# Single-agent install: set it here.
# Shared install (several agents, one clone): DELETE this line, and have each
# agent pass `--agent <name>` per call or set IC_AGENT in its own process
# environment. Leaving a default here hands one agent's name to any process that
# forgets to choose.
IC_AGENT=your_agent_name


## ─── Optional ────────────────────────────────────────────────────────────────

# A CA bundle, if your workspace uses a certificate your system does not trust —
# a self-signed cert on a local install, typically.
#IC_CA=/path/to/rootCA.pem

# Keeping credentials out of this directory
# -----------------------------------------
# If this clone might ever be published, copied or zipped, do not put a token in
# it at all. Put the settings above in a file OUTSIDE the tree and point at it:
#
#   IC_ENV_FILE=/path/outside/the/repo/ic-kit.env
#
# This file is read first, then IC_ENV_FILE is followed, then the process
# environment beats both. A .gitignore stops a commit; it does not stop a folder
# copy — so a tree carrying a path rather than a token is the only one that is
# safe to hand to someone. You can also skip `.env` entirely and set IC_ENV_FILE
# in your process environment on every call.

# Talking to two workspaces from one clone
# ----------------------------------------
# Suffix any setting with _<AGENT> to override it for that agent — useful when
# one clone reaches both a live server and a local one, which genuinely have
# different tokens. The suffixed value wins when IC_AGENT matches.
#IC_URL_CLAUDE=https://localhost/?api=cli
#IC_BASE_CLAUDE=space.your-local-username
#IC_TOKEN_CLAUDE=that-workspaces-own-token
#IC_CA_CLAUDE=/path/to/rootCA.pem
